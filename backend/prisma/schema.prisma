// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../mongodb/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url = env("DATABASE_URL")
}


model User { 
  id    String  @id @default(auto()) @map("_id") @db.ObjectId
  email String  @unique
  name  String @unique
  password String
  communityIds String[] @db.ObjectId
  communities Community[] @relation("UserCommunities",references: [id],fields: [communityIds])
} 
model Community{
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String @unique
  admin String @db.ObjectId
  moderators String[] @db.ObjectId
  memberIds String[] @db.ObjectId
  members User[] @relation("UserCommunities",references: [id],fields: [memberIds]) 
  createdAt DateTime @default(now())
}
model Roles{
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String
  permissions String[]
}

model Message{
  id String @id @default(auto()) @map("_id") @db.ObjectId
  content String
  sender String @db.ObjectId
  communityId String @db.ObjectId
  status String
  createdAt DateTime @default(now())
}
